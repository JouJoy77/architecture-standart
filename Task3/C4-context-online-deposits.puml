@startuml C4_context_online_deposits
!include <C4/C4_Context>

title Банк «Стандарт» - открытие депозитов онлайн (MVP)\nC4: системный контекст
LAYOUT_TOP_DOWN()

Person(client, "Действующий клиент", "Выбирает предложение, подтверждает заявку СМС-кодом и следит за статусом")
Person(prospect, "Потенциальный клиент", "Оставляет на сайте заявку на обратный звонок")
Person(call_center_operator, "Оператор банковского кол-центра", "Связывается с потенциальным клиентом и фиксирует результат")
Person(deposit_manager, "Менеджер депозитного бэк-офиса", "Обрабатывает заявку и публикует ставки или персональные предложения")
Person(credit_manager, "Сотрудник кредитного бэк-офиса", "Согласует параметры риска в своём разделе АБС")
Person(branch_employee, "Сотрудник отделения", "Идентифицирует нового клиента")

Enterprise_Boundary(bank, "Банк «Стандарт»") {
    System(internet_bank, "Интернет-банк", "Заявка действующего клиента и просмотр статуса")
    System(website, "Сайт банка", "Публичный каталог депозитов и заявка на обратный звонок")
    System(deposit_platform, "Платформа депозитных заявок", "Приём заявок, подтверждение, клиентские статусы и уведомления")
    System(rate_distribution, "Сервис распространения ставок", "Единая read-модель продуктовых ставок и персональных предложений; детализирован в ADR-002")
    System(abs, "АБС", "Источник банковских операций, решений, ставок и персональных предложений")
    System(call_center, "Система банковского кол-центра", "Обратный звонок по заявке с сайта")
}

System_Ext(sms_gateway, "СМС-шлюз телеком-оператора", "Отправляет одноразовые коды и уведомления")

Rel(client, internet_bank, "Подаёт заявку и смотрит статус", "HTTPS")
Rel(prospect, website, "Выбирает продукт и оставляет заявку", "HTTPS")
Rel(internet_bank, deposit_platform, "Передаёт заявки и получает статусы", "REST / TLS")
Rel(internet_bank, rate_distribution, "Читает продуктовые ставки и предложения своего клиента", "REST / TLS")
Rel(website, rate_distribution, "Читает публичный каталог ставок", "REST / TLS")
Rel(website, deposit_platform, "Передаёт заявку на обратный звонок", "REST / TLS")
Rel(deposit_platform, rate_distribution, "Проверяет выбранную версию или персональное предложение", "REST / mTLS")

Rel(deposit_platform, abs, "Команды: зарегистрировать заявку, открыть продукт", "Kafka через адаптер АБС")
Rel(abs, deposit_platform, "Отложенные события решения и открытия из transactional outbox", "Kafka через адаптер АБС")
Rel(abs, rate_distribution, "Публикует продуктовые ставки и персональные предложения из outbox", "Kafka через адаптер АБС")

Rel(deposit_platform, call_center, "Создаёт обращение по заявке с сайта", "REST через адаптер")
Rel(call_center_operator, call_center, "Обрабатывает обращение и фиксирует результат")
Rel(call_center, abs, "Передаёт обращение после разговора", "Существующая интеграция")
Rel(deposit_manager, abs, "Обрабатывает заявки и публикует предложения")
Rel(credit_manager, abs, "Согласует риск в своей роли")
Rel(branch_employee, abs, "Идентифицирует клиента и оформляет документы")

Rel(deposit_platform, sms_gateway, "Отправляет OTP и уведомления", "HTTPS API")
Rel(sms_gateway, client, "Доставляет СМС")

note right of rate_distribution
Сайт получает только публичные ставки.
Персональное предложение выдаётся после
аутентификации и проверки клиента.
end note

SHOW_LEGEND()
@enduml
