@startuml C4_context_rate_distribution
!include <C4/C4_Context>

title Банк «Стандарт» - передача депозитных ставок\nC4: системный контекст
LAYOUT_LEFT_RIGHT()

Person(credit_manager, "Сотрудник кредитного бэк-офиса", "Вводит расчётные параметры и результат оценки риска")
Person(deposit_manager, "Сотрудник депозитного бэк-офиса", "Формирует, публикует и отзывает продуктовые ставки и персональные предложения")
Person(bank_operator, "Оператор банковского кол-центра", "Консультирует клиента по актуальным ставкам")
Person(ops, "Служба сопровождения", "Контролирует актуальность, квитанции и ошибки доставки")
Person_Ext(partner_operator, "Оператор партнёрского кол-центра", "Консультирует клиента по локальной версии справочника")

Enterprise_Boundary(bank, "Банк «Стандарт»") {
    System(abs, "АБС", "Единственный источник продуктовых ставок и персональных предложений")
    System(rate_distribution, "Сервис распространения ставок", "Единая read-модель, разделённые API, файлы публичных ставок, квитанции и контроль актуальности")
    System(bank_call_center, "Система банковского кол-центра", "Показывает оператору ставки, версию и время обновления")
    System(sftp, "Банковский SFTP", "Защищённый файловый обмен с партнёром")
}

System_Ext(partner_call_center, "Система партнёрского кол-центра", "Импортирует файл, показывает ставки и возвращает квитанцию")

Rel(credit_manager, abs, "Работает в разделе кредитных рисков")
Rel(deposit_manager, abs, "Формирует и публикует версию ставок")
Rel(abs, rate_distribution, "Передаёт продуктовые ставки, персональные предложения и отзывы", "Kafka")

Rel(bank_operator, bank_call_center, "Открывает карточку консультации")
Rel(bank_call_center, rate_distribution, "Запрашивает актуальные ставки", "REST / TLS")

Rel(rate_distribution, sftp, "Размещает зашифрованный OpenPGP-комплект и отделённую подпись", "SFTP / SSH")
Rel(sftp, partner_call_center, "Отдаёт полный снимок публичных ставок", "SFTP")
Rel(partner_call_center, sftp, "Возвращает квитанцию импорта", "SFTP")
Rel(partner_operator, partner_call_center, "Использует локальный справочник")

Rel(rate_distribution, ops, "Передаёт метрики и создаёт инциденты")

note right of partner_call_center
Партнёру передаются только публичные
условия продуктов. Персональные ставки
и данные клиентов в обмен не входят.
SHA-256 - контрольная сумма, подлинность
подтверждает отделённая OpenPGP-подпись.
end note

SHOW_LEGEND()
@enduml
