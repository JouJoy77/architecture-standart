  <diagram id="roadmap-mvp" name="MVP - 6 месяцев">
    <mxGraphModel dx="2571" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1520" background="#ffffff" math="0" shadow="0">
