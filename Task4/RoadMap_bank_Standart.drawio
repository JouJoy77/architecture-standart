        <mxCell id="title" parent="1" style="text;html=1;align=center;fontSize=24;fontStyle=1;" value="Roadmap банка «Стандарт»: MVP открытия депозитов и передачи ставок" vertex="1">
          <mxGeometry height="40" width="1900" x="80" y="20" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" parent="1" style="shape=note;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;align=left;spacing=8;" value="Горизонт - 6 месяцев. В план включены онлайн-заявки, ручная обработка в АБС и передача ставок обоим кол-центрам. Критические условия: Java/Kafka-команда выделена в месяц 1, договорённости с обоими подрядчиками закрыты до конца месяца 2. Иначе объём или дата MVP пересматриваются." vertex="1">
          <mxGeometry height="50" width="1900" x="80" y="70" as="geometry" />
        </mxCell>
